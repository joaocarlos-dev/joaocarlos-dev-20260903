{
  "info": {
    "_postman_id": "8c722a4c-5f4b-4b29-8d9f-2f5c5a58a101",
    "name": "Employee Management System API",
    "description": "Coleção para validar as rotas da API. Execute Health Check e Login primeiro. O token e os IDs criados são armazenados automaticamente nas variáveis da coleção.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "adminLogin",
      "value": "admin"
    },
    {
      "key": "adminPassword",
      "value": "change-this-initial-password"
    },
    {
      "key": "conventionalUserId",
      "value": ""
    },
    {
      "key": "administratorUserId",
      "value": ""
    },
    {
      "key": "unitId",
      "value": ""
    },
    {
      "key": "employeeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Infraestrutura e autenticação",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Login do administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Retorna 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('accessToken', json.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{adminLogin}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "Usuários",
      "item": [
        {
          "name": "Criar usuário convencional",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Retorna 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const id = pm.response.json();",
                  "pm.expect(id).to.be.a('string').and.match(/^[0-9a-f-]{36}$/i);",
                  "pm.collectionVariables.set('conventionalUserId', id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"USR-POSTMAN-001\",\n  \"login\": \"postman.user\",\n  \"password\": \"Password123!\",\n  \"status\": 1,\n  \"role\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/users"
          }
        },
        {
          "name": "Criar usuário administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Retorna 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const id = pm.response.json();",
                  "pm.expect(id).to.be.a('string').and.match(/^[0-9a-f-]{36}$/i);",
                  "pm.collectionVariables.set('administratorUserId', id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"ADM-POSTMAN-001\",\n  \"login\": \"postman.admin\",\n  \"password\": \"Password123!\",\n  \"status\": 1,\n  \"role\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/users"
          }
        },
        {
          "name": "Listar usuários",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users"
          }
        },
        {
          "name": "Listar usuários ativos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users?status=Active"
          }
        },
        {
          "name": "Buscar usuário por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/{{conventionalUserId}}"
          }
        },
        {
          "name": "Atualizar usuário",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"NewPassword123!\",\n  \"status\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/users/{{conventionalUserId}}"
          }
        }
      ]
    },
